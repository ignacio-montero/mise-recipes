# ── Mise — copy to .env and fill in. NEVER commit the real .env. ──────────────

# SQLite.
# ⚠️ A RELATIVE file: URL is resolved relative to prisma/schema.prisma, NOT the
# project root. So `file:./dev.db` means prisma/dev.db — writing
# `file:./prisma/dev.db` silently creates prisma/prisma/dev.db and leaves you
# staring at an empty database. The container uses an ABSOLUTE path, which has
# no such ambiguity.
# Local dev: file:./dev.db      Container: file:/app/data/mise.db
DATABASE_URL="file:./dev.db"

# Where the volume lives inside the container (images + temp downloads).
DATA_DIR="./data"

# ── Gemini (structuring + audio transcription) ───────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Fallback chain, first to answer wins. A busy model returns 503, so more than
# one name here is load-bearing — see docs/RESEARCH-extraction.md §3.
GEMINI_MODELS="gemini-2.5-flash,gemini-3.5-flash,gemini-2.5-flash-lite"

# ── Telegram ingest bot ──────────────────────────────────────────────────────
# ⚠️ This bot needs its OWN token. Only ONE process may long-poll a token; the
# Tennis bot's token is already held by tennisbot-prefs. See docs/DECISIONS.md D-003.
TELEGRAM_BOT_TOKEN=""
# Only this chat id is honoured; every other chat is ignored.
TELEGRAM_CHAT_ID=""

# Shared secret the bot presents to POST /api/imports. Any long random string.
OSTA_INGEST_TOKEN=""

# Where the bot reaches the web app (Docker network name in production).
MISE_API_BASE="http://localhost:3000"
# Base URL the bot puts in "open recipe" links (what the phone can reach).
MISE_PUBLIC_BASE="https://homelab.tailf48262.ts.net"

# ── Extraction tuning ────────────────────────────────────────────────────────
# Skip the audio tier entirely (fastest, caption-only).
ENABLE_AUDIO_TIER="true"
# Refuse to download audio for videos longer than this (seconds).
MAX_AUDIO_SECONDS="300"
# Optional: netscape-format cookie file to unlock private/age-gated Instagram.
# Not required for public reels — see docs/RESEARCH-extraction.md.
YTDLP_COOKIES_FILE=""
